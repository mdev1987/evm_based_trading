# ──────────────────────────────────────────────────────────────────────────────
# EVM Trading Bot v2.0.0
# Bun loads .env automatically.
# ──────────────────────────────────────────────────────────────────────────────

# Runtime
MODE=paper
CHAINS=ARC,Robinhood
STATE_DIR=.data

# Live wallet. Required only when MODE=live.
# Never commit a real mnemonic.
MNEMONIC=
WALLET_ACCOUNT_INDEX=0
LIVE_TRADING_CONFIRM=YES

# ──────────────────────────────────────────────────────────────────────────────
# Paper wallet / risk
# PAPER_INITIAL_NATIVE is ignored on chains whose base asset is native (Arc).
# ──────────────────────────────────────────────────────────────────────────────
PAPER_INITIAL_BASE=1
PAPER_INITIAL_NATIVE=0.01
BUY_AMOUNT_BASE=0.1
# USD-denominated paper sizing (both required together).
# Starting balance and per-trade size convert to each chain's base asset at
# boot: $1 for native stablecoins (Arc USDC), otherwise DexPaprika with a
# DexScreener fallback. Falls back to the raw amounts above when unpriced.
# Leave both empty to use the raw base-unit amounts (and for live sizing).
PAPER_INITIAL_USD=100
BUY_AMOUNT_USD=10
MAX_OPEN_POSITIONS=3
SIGNAL_REENTRY_COOLDOWN_MS=21600000

# gainPercent:sellPercent; e.g. +25% => sell 50%, +50% => sell the remainder.
TAKE_PROFIT_LEVELS=25:50,50:100
TRAILING_ACTIVATION_PERCENT=30
TRAILING_DISTANCE_PERCENT=10
# Time-stop: close positions held longer than this (ms); 0 disables.
TIME_STOP_MS=86400000

# ──────────────────────────────────────────────────────────────────────────────
# Debot AI Rank
# ──────────────────────────────────────────────────────────────────────────────
DEBOT_BASE_URL=https://debot.ai/api/community/signal/channel
DEBOT_DURATION=1m
DEBOT_LIMIT=10
DEBOT_POLL_INTERVAL_MS=30000
DEBOT_TIMEOUT_MS=10000
# Keyless major-asset spot prices (e.g. ETHUSDT) used for base-asset USD sizing.
DEBOT_PRICE_STATE_URL=https://debot.ai/api/market/price_state
# Dashboard ranks POST endpoint (Arc signal source).
DEBOT_DASHBOARD_BASE_URL=https://debot.ai

# ──────────────────────────────────────────────────────────────────────────────
# DexScreener price tracking
# Maximum 30 token addresses per API request.
# ──────────────────────────────────────────────────────────────────────────────
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_INTERVAL_MS=2000
DEXSCREENER_TIMEOUT_MS=10000
DEXSCREENER_MAX_ADDRESSES=30
TRACKED_TOKEN_TTL_MS=600000
LOG_PRICES=false

# ──────────────────────────────────────────────────────────────────────────────
# DexPaprika base-asset USD pricing (paper USD sizing)
# ──────────────────────────────────────────────────────────────────────────────
DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_TIMEOUT_MS=10000
# Newest-pools signal feed: pools fetched per poll per active chain.
DEXPAPRIKA_POOL_LIMIT=10

# ──────────────────────────────────────────────────────────────────────────────
# 0x Swap API / WDK
# ──────────────────────────────────────────────────────────────────────────────
ZERO_EX_API_KEY=
ZERO_EX_BASE_URL=https://api.0x.org
ZERO_EX_DEFAULT_SLIPPAGE=0.005
ZERO_EX_MAX_NETWORK_FEE_BPS=100
ZERO_EX_MAX_PROTOCOL_FEE_BPS=100
# false = allow WDK to perform the supported ERC-20 approval flow.
ZERO_EX_SKIP_APPROVAL=false

# ──────────────────────────────────────────────────────────────────────────────
# Live transaction confirmation
# ──────────────────────────────────────────────────────────────────────────────
EXECUTION_POLL_INTERVAL_MS=3000
EXECUTION_TIMEOUT_MS=120000

# Console / Telegram status interval
STATUS_INTERVAL_MS=10000

# ──────────────────────────────────────────────────────────────────────────────
# Telegram reporting
# Startup, shutdown, buys, exits and important errors are sent when enabled.
# Periodic status reports are separately controlled.
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STATUS_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# Arc (chain ID 5042)
# Native gas/trading asset: USDC, represented to 0x by the native-token sentinel.
# ──────────────────────────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.arc-scan.org
ARC_DEBOT_CHAIN=arc
# Active feeds in priority order: community (Debot rank GET), dashboard
# (Debot ranks POST), dexpaprika (SDK new pools, currently disabled).
# Arc community rank is empty — dashboard only for now.
ARC_SIGNAL_SOURCES=dashboard
ARC_DEBOT_COLUMNS=new,completing,completed
ARC_DEBOT_MEME_TYPES=arc:dyorfun,arc:dyorfun_v3,arc:onmifun,arc:argus,arc:o1,arc:circlewarp,arc:actfun,arc:ubifun,arc:klik,arc:trench,arc:radardex,arc:archemist,arc:minara,arc:akafun,arc:pegdfun,arc:tolly,arc:peach,arc:liftfun,arc:synthra
ARC_DEXSCREENER_CHAIN=arc
ARC_DEXPAPRIKA_NETWORK=arc
ARC_BASE_TOKEN=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
ARC_BASE_SYMBOL=USDC
ARC_BASE_DECIMALS=18
ARC_BASE_IS_NATIVE=true
ARC_NATIVE_SYMBOL=USDC
ARC_NATIVE_DECIMALS=18
ARC_NATIVE_TO_BASE_RATE=1
ARC_EXPLORER_URL=https://arc-scan.org/tx/
# Entry snapshot filters (0 = disabled). Missing data fails an enabled check.
ARC_MIN_LIQUIDITY_USD=0
ARC_MIN_VOLUME_USD_24H=0
ARC_MIN_TXNS_24H=0

# ──────────────────────────────────────────────────────────────────────────────
# Robinhood Chain (chain ID 4663)
# Base: WETH. Gas: native ETH.
# ──────────────────────────────────────────────────────────────────────────────
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_DEBOT_CHAIN=robinhood
# GET community rank + POST dashboard ranks (DexPaprika disabled for now).
ROBINHOOD_SIGNAL_SOURCES=community,dashboard
ROBINHOOD_DEBOT_COLUMNS=new,completing,completed
ROBINHOOD_DEBOT_MEME_TYPES=robinhood:pons,robinhood:pons_v2,robinhood:flap,robinhood:flap_stocks_vault,robinhood:uni_instant,robinhood:uni_crowd,robinhood:o1,robinhood:lunchfun,robinhood:pairfund,robinhood:dyorfun,robinhood:dyorfun_v3,robinhood:virtuals_unicorn,robinhood:noxafun,robinhood:noxafi,robinhood:long,robinhood:letscash,robinhood:clanker,robinhood:bankr,robinhood:varo,robinhood:sushi,robinhood:poolsfun,robinhood:bowfun,robinhood:bags,robinhood:trench,robinhood:apestore,robinhood:circus,robinhood:klik,robinhood:memecoinfun_v4,robinhood:arrow
ROBINHOOD_DEXSCREENER_CHAIN=robinhood
ROBINHOOD_DEXPAPRIKA_NETWORK=robinhood
ROBINHOOD_BASE_TOKEN=0x0bd7d308f8e1639fab988df18a8011f41eacad73
ROBINHOOD_BASE_SYMBOL=WETH
ROBINHOOD_BASE_DECIMALS=18
ROBINHOOD_BASE_IS_NATIVE=false
ROBINHOOD_NATIVE_SYMBOL=ETH
ROBINHOOD_NATIVE_DECIMALS=18
ROBINHOOD_NATIVE_TO_BASE_RATE=1
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com/tx/
# Entry snapshot filters (0 = disabled). Missing data fails an enabled check.
ROBINHOOD_MIN_LIQUIDITY_USD=0
ROBINHOOD_MIN_VOLUME_USD_24H=0
ROBINHOOD_MIN_TXNS_24H=0
